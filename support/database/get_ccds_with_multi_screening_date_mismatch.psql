/* Query to find CCDs that would have had multiple screenings come in and may not have been counted because of the effectiveDateTime issue.
 -- Please update the from_date and to_date as per the preference in the line 49 as beow before executing the query.
 -- AND r.created_at >= '2026-10-01' AND r.created_at <= '2026-10-07'
*/

-- Helper 1: tolerant XML parser 
CREATE OR REPLACE FUNCTION techbd_udi_ingress.try_xml(p text) RETURNS xml LANGUAGE plpgsql AS $$
BEGIN
  RETURN xmlparse(document ltrim(p, E'\ufeff \t\r\n'));
EXCEPTION WHEN OTHERS THEN
  RETURN NULL;
END $$;

-- Helper 2: HL7 TS (YYYYMMDD[HH[MM[SS]]][+/-ZZZZ]) -> timestamptz, so CCDA dates and FHIR dates are comparable.
-- Values without a time zone are treated as UTC.
CREATE OR REPLACE FUNCTION techbd_udi_ingress.hl7_ts_to_tstz(p text) RETURNS timestamptz LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE
  digits text := substring(p from '^\d+');
  tz     text := substring(p from '([+-]\d{4})$');
BEGIN
  IF digits IS NULL OR length(digits) < 8 THEN RETURN NULL; END IF;
  digits := rpad(substr(digits, 1, 14), 14, '0');
  RETURN to_timestamp(digits || coalesce(tz, '+0000'), 'YYYYMMDDHH24MISSTZHTZM');
EXCEPTION WHEN OTHERS THEN
  RETURN NULL;
END $$;

WITH params AS (
  SELECT '|71802-3|96778-6|96779-4|88122-7|88123-5|93030-5|96780-2|96782-8|95618-5|95617-7|95616-9|95615-1|95614-4|'::text AS allowed
),
xp AS (
  SELECT
    allowed,
    format('//h:observation[h:entryRelationship/h:observation/h:code[contains(%L, concat(''|'', @code, ''|''))]]', allowed) AS sets,
    format('//h:entry/h:observation[.//h:entryRelationship/h:observation/h:code[contains(%L, concat(''|'', @code, ''|''))]]', allowed) AS entries,
    format('//h:observation[h:entryRelationship/h:observation/h:code[contains(%L, concat(''|'', @code, ''|''))]]'
           '/h:entryRelationship/h:observation/h:code[contains(%L, concat(''|'', @code, ''|''))]/@code', allowed, allowed) AS answer_codes
  FROM params
),
src AS MATERIALIZED (
  -- the ORIGINAL CCDA payload only
  SELECT DISTINCT ON (r.hub_interaction_id)
         r.hub_interaction_id, r.tenant_id, r.file_name, r.ccda_authoring_device, r.created_at,
         r.ccda_payload_text
  FROM techbd_udi_ingress.sat_interaction_ccda_request r
  WHERE r.nature = 'Original CCDA Payload'
    AND r.ccda_payload_text IS NOT NULL
    --AND r.created_at >= now() - interval '30 days'          -- adjust the window / add a tenant filter
    AND r.created_at >= '2026-10-01' AND r.created_at <= '2026-10-07'
    AND r.ccda_payload_text ~ '71802-3|96778-6|96779-4|88122-7|88123-5|93030-5|96780-2|96782-8|95618-5|95617-7|95616-9|95615-1|95614-4'
  ORDER BY r.hub_interaction_id, r.created_at DESC
),
counted AS MATERIALIZED (
  SELECT s.hub_interaction_id, s.tenant_id, s.file_name, s.ccda_authoring_device, s.created_at, x.x, xp.*,
         (xpath('count(' || xp.sets    || ')', x.x, ARRAY[ARRAY['h','urn:hl7-org:v3']]))[1]::text::int AS screening_sets,
         (xpath('count(' || xp.entries || ')', x.x, ARRAY[ARRAY['h','urn:hl7-org:v3']]))[1]::text::int AS grouper_entries
  FROM src s
  CROSS JOIN xp
  CROSS JOIN LATERAL (SELECT techbd_udi_ingress.try_xml(s.ccda_payload_text) AS x) x
  WHERE x.x IS NOT NULL
)
SELECT c.hub_interaction_id AS bundle_id, c.tenant_id, c.file_name, c.ccda_authoring_device, c.created_at,
       c.screening_sets, c.grouper_entries,
       array_to_string(xpath(c.sets || '/h:effectiveTime/@value | ' || c.sets || '/h:effectiveTime/h:low/@value',
                             c.x, ARRAY[ARRAY['h','urn:hl7-org:v3']])::text[], ', ')        AS screening_dates,
       rc.repeated_codes,                                                                   -- codes answered in more than one screening
       cd.ccda_effective_dates      AS new_logic_effective_dates,                           -- dates derived from the CCDA (new logic)
       fd.fhir_effective_dates      AS saved_fhir_effective_dates                           -- dates in the already saved FHIR bundle
FROM counted c
LEFT JOIN LATERAL (
  SELECT string_agg(code, ', ' ORDER BY code) AS repeated_codes
  FROM (SELECT a::text AS code
        FROM unnest(xpath(c.answer_codes, c.x, ARRAY[ARRAY['h','urn:hl7-org:v3']])) a
        GROUP BY a::text HAVING count(*) > 1) d
) rc ON true
-- effective dates from the CCDA, normalised to timestamptz
LEFT JOIN LATERAL (
  SELECT array_agg(t ORDER BY t) AS ccda_effective_dates
  FROM (SELECT DISTINCT techbd_udi_ingress.hl7_ts_to_tstz(a::text) AS t
        FROM unnest(xpath(c.sets || '/h:effectiveTime/@value | ' || c.sets || '/h:effectiveTime/h:low/@value',
                          c.x, ARRAY[ARRAY['h','urn:hl7-org:v3']])) a) q
  WHERE t IS NOT NULL
) cd ON true
-- effectiveDateTime values of the screening Observations in the saved 'Converted to FHIR' bundle
LEFT JOIN LATERAL (
  SELECT array_agg(t ORDER BY t) AS fhir_effective_dates
  FROM (
    SELECT DISTINCT (e.entry->'resource'->>'effectiveDateTime')::timestamptz AS t
    FROM (SELECT f.payload::jsonb AS bundle
          FROM techbd_udi_ingress.sat_interaction_ccda_request f
          WHERE f.hub_interaction_id = c.hub_interaction_id
            AND f.nature = 'Converted to FHIR'
          ORDER BY f.created_at DESC
          LIMIT 1) fb
    CROSS JOIN LATERAL jsonb_array_elements(fb.bundle->'entry') e(entry)
    WHERE e.entry->'resource'->>'resourceType' = 'Observation'
      AND e.entry->'resource'->>'effectiveDateTime' IS NOT NULL
      AND ( e.entry->'resource' ? 'hasMember'                      -- screening grouper / set observation
            OR EXISTS (SELECT 1
                       FROM jsonb_array_elements(e.entry->'resource'->'code'->'coding') k
                       WHERE position('|' || (k->>'code') || '|' in c.allowed) > 0) )  -- answer observation
  ) q
  WHERE t IS NOT NULL
) fd ON true
WHERE c.screening_sets > 1
  AND fd.fhir_effective_dates IS NOT NULL                                  -- a saved FHIR bundle exists
  AND cd.ccda_effective_dates IS DISTINCT FROM fd.fhir_effective_dates     -- the two date sets differ
ORDER BY c.created_at DESC, c.screening_sets DESC;
