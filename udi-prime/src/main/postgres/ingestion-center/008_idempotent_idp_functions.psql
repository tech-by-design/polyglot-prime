/* Menu polulation */
DROP FUNCTION IF EXISTS techbd_udi_ingress.idp_get_role_menus_with_permissions(int);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.idp_get_role_menus_with_permissions(in_role_id int)
 RETURNS jsonb
 LANGUAGE plpgsql
AS $function$
DECLARE 
    result json;
    is_role_exist bool; 
BEGIN
    IF in_role_id IS NULL 
    THEN
        result := json_build_object(
            'status', 'error',
            'message', 'Role name is required. Please provide a valid role name.'
        );
        RETURN result;
    END IF;
    
    SELECT 
        EXISTS(SELECT 1 
              FROM techbd_udi_ingress.idp_roles
              WHERE role_id = in_role_id)
        INTO is_role_exist;
    
    IF (NOT is_role_exist)
    THEN
        result := json_build_object(
            'status', 'error',
            'message', 'The requested role does not exist.'
        );
        RETURN result;
    END IF;
 

WITH all_menu_screens_permissions AS (
SELECT
    mnu.mnu_id,
    mnu.mnu_code,
    mnu.mnu_name,
    sc.scr_id,
    sc.scr_code,
    sc.scr_name,
    sc.scr_type,
    sc.parent_scr_id,
    CASE
        WHEN rtpn.role_id IS NOT NULL THEN TRUE
        ELSE FALSE
    END AS has_permission
FROM techbd_udi_ingress.idp_screens sc
JOIN techbd_udi_ingress.idp_menu mnu
    ON sc.mnu_id = mnu.mnu_id
LEFT JOIN techbd_udi_ingress.idp_role_tenant_permission rtpn
    ON rtpn.mnu_id = mnu.mnu_id
   AND rtpn.scr_id = sc.scr_id
   AND rtpn.role_id = in_role_id
WHERE
    (
        sc.scr_group = 'data'
        AND mnu.mnu_group = 'data'
    )
ORDER BY
    mnu.order_no,
    sc.order_no
)
    
    SELECT jsonb_build_object(
            'status', 'success',
            'menu_screens', jsonb_agg(row_to_json(all_menu_screens_permissions))
        )
    INTO result
    FROM all_menu_screens_permissions;
    
    RETURN result;

END;
$function$;

/* Login user role permission */
DROP FUNCTION IF EXISTS techbd_udi_ingress.idp_get_login_role_permissions(text);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.idp_get_login_role_permissions(in_role_name text)
 RETURNS jsonb
 LANGUAGE plpgsql
AS $function$
DECLARE 
    result jsonb;
    is_role_exist bool;
    is_admin_role bool;
    has_config_access bool;
BEGIN
    IF in_role_name IS NULL 
    THEN
        result := jsonb_build_object(
            'status', 'error',
            'message', 'Role name cannot be empty'
        );
        RETURN result;
    END IF;
    
    SELECT EXISTS (
        SELECT 1 
        FROM techbd_udi_ingress.idp_roles
        WHERE role_name = in_role_name
    )
    INTO is_role_exist;
    
    IF (NOT is_role_exist)
    THEN
        result := jsonb_build_object(
            'status', 'error',
            'message', 'The requested role does not exist.'
        );
        RETURN result;
    END IF;

	-- Get is_admin and config_access
	SELECT
	    is_admin,
	    config_access
	INTO
	    is_admin_role,
	    has_config_access
	FROM techbd_udi_ingress.idp_roles
	WHERE role_name = in_role_name;


WITH login_role_permissions AS (
    -- 1. Super Admin -> All menus & screens
    SELECT
        mnu.mnu_name,
        sc.scr_name,
		sc.scr_id,
		sc.parent_scr_id
    FROM techbd_udi_ingress.idp_screens sc
    JOIN techbd_udi_ingress.idp_menu mnu
        ON sc.mnu_id = mnu.mnu_id
    WHERE
        is_admin_role = TRUE
        AND has_config_access = TRUE

    UNION ALL

    -- 2. Admin -> All Data menus & screens
    SELECT
        mnu.mnu_name,
        sc.scr_name,
		sc.scr_id,
		sc.parent_scr_id
    FROM techbd_udi_ingress.idp_screens sc
    JOIN techbd_udi_ingress.idp_menu mnu
        ON sc.mnu_id = mnu.mnu_id
    WHERE
        is_admin_role = TRUE
        AND has_config_access = FALSE
        AND sc.scr_group = 'data'
        AND mnu.mnu_group = 'data'

    UNION ALL

    -- 3. Other Roles -> Assigned permissions only
    SELECT
        mnu.mnu_name,
        sc.scr_name,
		sc.scr_id,
		sc.parent_scr_id
    FROM techbd_udi_ingress.idp_role_tenant_permission rtpn
    JOIN techbd_udi_ingress.idp_screens sc
        ON sc.scr_id = rtpn.scr_id
    JOIN techbd_udi_ingress.idp_menu mnu
        ON mnu.mnu_id = rtpn.mnu_id
    JOIN techbd_udi_ingress.idp_roles rl
        ON rl.role_id = rtpn.role_id
    WHERE
        is_admin_role = FALSE
        AND has_config_access = FALSE
        AND rl.role_name = in_role_name
),
screens_grouped AS ( 
    SELECT
        p.mnu_name,
        jsonb_agg(
            jsonb_build_object(
                'screen', p.scr_name,
                'children',
                COALESCE(
                    (
                        SELECT jsonb_agg(c.scr_name ORDER BY c.scr_name)
                        FROM login_role_permissions c
                        WHERE c.parent_scr_id = p.scr_id
                    ),
                    '[]'::jsonb
                )
            )
            ORDER BY p.scr_name
        ) AS screens
    FROM login_role_permissions p
    WHERE p.parent_scr_id IS NULL
    GROUP BY p.mnu_name 
)
    SELECT jsonb_object_agg(mnu_name, screens)
    INTO result
    FROM screens_grouped;

    RETURN result;

END;
$function$;

/* Menu polulation */
DROP FUNCTION IF EXISTS techbd_udi_ingress.idp_insert_role_menus_with_permissions(int, jsonb, timestamp, text);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.idp_insert_role_menus_with_permissions(
    in_role_id int,
    data jsonb,
    created_at timestamp,
    created_by text
) 
RETURNS jsonb
LANGUAGE plpgsql
AS $function$
DECLARE 
    is_role_exists BOOLEAN;
    inserted_count INT;
BEGIN
    -- Validation 1: check data
    IF data IS NULL OR jsonb_array_length(data) = 0 THEN
        RETURN jsonb_build_object(
            'status', 'error',
            'message', 'data cannot be empty'
        );
    END IF;

    -- Validation 2: check role
    IF in_role_id IS NULL THEN
        RETURN jsonb_build_object(
            'status', 'error',
            'message', 'Role should be selected'
        );
    END IF;

    -- Validation 3: role existence
    SELECT EXISTS (
        SELECT 1 FROM techbd_udi_ingress.idp_roles WHERE role_id = in_role_id
    ) INTO is_role_exists;

    IF is_role_exists THEN
        -- Step 1: clear old permissions in database table
        DELETE FROM techbd_udi_ingress.idp_role_tenant_permission
        WHERE role_id = in_role_id;
    END IF;

    -- Step 2: bulk insert new permissions
    INSERT INTO techbd_udi_ingress.idp_role_tenant_permission (role_id, mnu_id, scr_id, created_at, created_by, provenance)
    SELECT 
        in_role_id,
        mnu_id,
        scr_id,
        created_at,
        created_by,
		'Fusion Auth'
    FROM jsonb_to_recordset(data)
        AS mnu(mnu_id int, scr_id int);

    GET DIAGNOSTICS inserted_count = ROW_COUNT;

    -- Return success message
    RETURN jsonb_build_object(
        'status', 'success',
        'inserted_count', inserted_count,
        'message', 'Menu / Screen role permissions updated successfully'
    );
END;
$function$;

/* Function to insert group/tenant to local database from fusion techbd_udi_ingress (Json Response of fusion techbd_udi_ingress API is passed as input parameter)*/
DROP FUNCTION IF EXISTS techbd_udi_ingress.idp_upsert_tenants_from_json(jsonb);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.idp_upsert_tenants_from_json(groups_json jsonb)
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
    group_item jsonb;
    ten_code text;
    ten_name text;
    ten_desc text;
BEGIN
    -- Loop through each group object inside "groups" array
    FOR group_item IN
        SELECT * FROM jsonb_array_elements(groups_json->'groups')
    LOOP
        -- Extract tenant_id and tenant_name
        ten_code := group_item->>'id';
        ten_name := lower(group_item->>'name');
        --ten_desc := 'ten_' || ten_name;
		ten_desc := ten_name;

        -- Upsert into tenants table
        INSERT INTO techbd_udi_ingress.tenants (tenant_id, tenant_name, tenant_displayname, is_active, created_by, provenance, fusion_auth_group_id)
        VALUES (gen_random_uuid()::text, ten_name, ten_desc, true, CURRENT_USER, 'Fusion Auth', ten_code)
        ON CONFLICT (tenant_name) DO UPDATE
        SET tenant_name = EXCLUDED.tenant_name,
            tenant_displayname  = EXCLUDED.tenant_displayname,
            is_active  = true,
			created_by = CURRENT_USER,
			created_at = CURRENT_TIMESTAMP;
    END LOOP;
END;
$$;

/* Get roles from fusionauth json response from api*/
DROP FUNCTION IF EXISTS techbd_udi_ingress.idp_save_roles_from(jsonb);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.idp_save_roles_from(app_json jsonb)
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
    rol jsonb;
BEGIN
    -- Loop through each role in the JSON array
    FOR rol IN 
        SELECT * FROM jsonb_array_elements(app_json -> 'application' -> 'roles')
    LOOP
        -- Insert into the roles table
        INSERT INTO techbd_udi_ingress.idp_roles (role_code, role_name, display_name, description, is_admin, is_active, provenance)
        VALUES (
            rol ->> 'id',                     -- Use role ID as role_code
            rol ->> 'name',                   -- role_name
            rol ->> 'name',                   -- display_name same as role_name
            (rol ->> 'isSuperRole')::boolean, -- is_admin
            true,                             -- is_active
			'Fusion Auth'					  -- provenance
        )
        ON CONFLICT (role_code) DO UPDATE
        SET 
            role_name = EXCLUDED.role_name,
            display_name = EXCLUDED.display_name,
            is_admin = EXCLUDED.is_admin,
            is_active = EXCLUDED.is_active,
			created_at = CURRENT_TIMESTAMP
			;
    END LOOP;
END;
$$;


/*View that lists all active, non-admin roles (is_admin = false) from the idp_roles table.*/
DROP VIEW IF EXISTS techbd_udi_ingress.idp_vw_roles;
CREATE OR REPLACE VIEW techbd_udi_ingress.idp_vw_roles WITH (security_invoker = true)
AS SELECT 
      role_id,
      role_code,
      display_name AS role_name,
      description
   FROM techbd_udi_ingress.idp_roles
   WHERE NOT is_admin AND is_active;

DROP PROCEDURE IF EXISTS techbd_udi_ingress.configure_rls_policies();
CREATE OR REPLACE PROCEDURE techbd_udi_ingress.configure_rls_policies()
LANGUAGE plpgsql
AS $procedure$
DECLARE
    policy_tables text[][] := ARRAY[
        ARRAY['techbd_udi_ingress','sat_interaction_ccda_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_screening_info'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_screening_organization'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_screening_patient'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_session_diagnostic'],
        ARRAY['techbd_udi_ingress','sat_interaction_flat_file_csv_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_hl7_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_http_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_user'],
        ARRAY['techbd_udi_ingress','sat_interaction_ui_user'],
        ARRAY['techbd_udi_ingress','sat_interaction_zip_file_request'],
        ARRAY['techbd_udi_ingress','sat_diagnostic_dataledger_api'],
        ARRAY['techbd_udi_ingress','sat_diagnostic_exception'],
        ARRAY['techbd_udi_ingress','sat_diagnostic_log'],
        ARRAY['techbd_udi_ingress','sat_expectation_http_request'],
        ARRAY['techbd_udi_ingress','sat_interaction_fhir_validation_issue'],
        ARRAY['techbd_udi_ingress','sat_interaction_file_exchange'],
        ARRAY['techbd_udi_ingress','sat_interaction_ccda_validation_errors'],
        ARRAY['techbd_udi_ingress','sat_interaction_hl7_validation_errors'],
        ARRAY['techbd_udi_ingress','dashboard_widget_metadata'],
        ARRAY['techbd_udi_ingress','sat_csv_fhir_processing_errors'],

        ARRAY['mco_data','mco_record_details'],
        ARRAY['mco_data','mco_record_error_logs'],
        ARRAY['mco_data','mco_records']
    ];

    tenant_col text := 'tenant_id';
    schema_name text;
    tbl text;
    qry text;
    i int;
BEGIN
    FOR i IN 1..array_length(policy_tables,1) LOOP
        schema_name := policy_tables[i][1];
        tbl         := policy_tables[i][2];

        EXECUTE format('DROP POLICY IF EXISTS select_policy_%I ON %I.%I', tbl, schema_name, tbl);

        qry := format($P$
	            CREATE POLICY select_policy_%I
	            ON %I.%I
	            FOR SELECT
		            USING (
		                current_setting('jwt.claims.is_admin', true)::boolean
		                OR
		                %I = ANY (
		                    string_to_array(
		                        current_setting('jwt.claims.tenants', true),
		                        ','
		                    )
		                )
		            );
		        $P$, tbl, schema_name, tbl, tenant_col);
        EXECUTE qry;

        EXECUTE format('ALTER TABLE %I.%I ENABLE ROW LEVEL SECURITY', schema_name, tbl);
        EXECUTE format('ALTER TABLE %I.%I FORCE ROW LEVEL SECURITY', schema_name, tbl);
    END LOOP;
END;
$procedure$
;

DROP FUNCTION IF EXISTS techbd_udi_ingress.set_role_based_on_fusion_token(jsonb);

DROP FUNCTION IF EXISTS techbd_udi_ingress.set_role_based_on_fusion_token(text, text[], boolean);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.set_role_based_on_fusion_token(
    activeTenant text,
    roles text[],
    is_admin boolean
)
RETURNS text
LANGUAGE plpgsql
AS $function$
DECLARE
    v_user_roles text;
    v_tenant_id text;
BEGIN
    -- Convert role array to comma-separated lowercase string
    SELECT array_to_string(
        ARRAY(
            SELECT lower(trim(r))
            FROM unnest(roles) AS r
        ),
        ','
    )
    INTO v_user_roles;

    -- Get tenant_id for the supplied tenant name
    SELECT t.tenant_id
    INTO v_tenant_id
    FROM techbd_udi_ingress.tenants t
    WHERE lower(t.tenant_name) = lower(activeTenant)
      AND t.is_active
    LIMIT 1;

    -- Set session variables
    PERFORM set_config(
        'jwt.claims.user_roles',
        COALESCE(v_user_roles, ''),
        false
    );

    PERFORM set_config(
        'jwt.claims.tenants',
        COALESCE(v_tenant_id, ''),
        false
    );

    PERFORM set_config(
        'jwt.claims.is_admin',
        COALESCE(is_admin, false)::text,
        false
    );

    RETURN v_tenant_id;
END;
$function$;


DROP FUNCTION IF EXISTS techbd_udi_ingress.get_active_tenants();
CREATE OR REPLACE FUNCTION techbd_udi_ingress.get_active_tenants()
 RETURNS TABLE(p_tenant_id text, p_tenant_name text, p_tenant_type text)
 LANGUAGE plpgsql
AS $function$ 
BEGIN
    RETURN QUERY
    SELECT tenant_id, 
        tenant_displayname AS tenant_name, 
        tenant_type
    FROM techbd_udi_ingress.tenants
    WHERE is_active = true
ORDER BY tenant_name ASC;
END;
$function$
;


DROP FUNCTION IF EXISTS techbd_udi_ingress.set_admin_context_for_github_login(text);
CREATE OR REPLACE FUNCTION techbd_udi_ingress.set_admin_context_for_github_login(
    p_auth_provider text
)
RETURNS text
LANGUAGE plpgsql
AS $function$
BEGIN
    IF lower(p_auth_provider) = 'github' THEN
        PERFORM set_config('jwt.claims.is_admin', 'true', false);
    ELSE
        RAISE EXCEPTION 'Unsupported authentication provider: %', p_auth_provider;
    END IF;

    RETURN 'SUCCESS';
END;
$function$;