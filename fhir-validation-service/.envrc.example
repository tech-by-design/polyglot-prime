# Rename this file `.envrc` and use it during development.
# Secrets should be kept in a vault or passed through environments
# and never stored in Git.

# If you want use these, remember to start VSCode or your IDE after `direnv allow`

# use Spring profiles as 'localopen' for testing locally with no authentication, `sandbox` for testing with auth in localhost , `devl`, `stage`, `prod`
export SPRING_PROFILES_ACTIVE=sandbox
export sandbox_TECHBD_UDI_DS_PRIME_JDBC_URL=jdbc:postgresql://aws.neon.tech/persistence-prime-test
export sandbox_TECHBD_UDI_DS_PRIME_JDBC_USERNAME=persistence-prime-test
export sandbox_TECHBD_UDI_DS_PRIME_JDBC_PASSWORD=**********
export TECHBD_ALLOWED_HOSTS=localhost:8080
export TECHBD_BL_BASEURL=https://synthetic.fhir.api.devl.techbd.org
export TECHBD_MAVEN_ROOT_DIR=/home/user/.m2
export TECHBD_DATA_LEDGER_API_URL=https://gbp2obo8d0.execute-api.us-east-1.amazonaws.com/dev/DataLedger
export TECHBD_DATA_LEDGER_TRACKING_ENABLED=true
export TECHBD_DATA_LEDGER_DIAGNOSTICS_ENABLED=true
export TECHBD_BASE_FHIR_URL=http://test.shinny.org/us/ny/hrsn